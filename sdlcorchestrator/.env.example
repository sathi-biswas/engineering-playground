# LLM Provider: gemini (default, free) | openai | anthropic
LLM_PROVIDER=gemini

# Gemini API Key (100% Free from Google AI Studio)
GEMINI_API_KEY=AQ.Ab

# Optional paid providers
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# FinOps model tiers (Gemini free-tier defaults)
MODEL_LOW=gemini-3.6-flash
MODEL_MID=gemini-3.6-flash
MODEL_HIGH=gemini-3.6-flash

# GitHub
GITHUB_TOKEN=ghp_
GITHUB_REPO_NAME=sathi-biswas/engineering-playground
GITHUB_BASE_BRANCH=main

# Google Drive
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GDRIVE_FOLDER_ID=
GDRIVE_BUG_FILE_ID=

# Runtime defaults
# TARGET_REPO_PATH=/absolute/path/to/local/clone
ENABLE_REVISION_LOOP=true

# Test runner
PYTEST_ARGS=-q --tb=short
