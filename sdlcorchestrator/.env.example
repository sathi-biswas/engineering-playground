# LLM Provider: gemini (default, free) | openai | anthropic
LLM_PROVIDER=gemini

# Gemini API Key (100% Free from Google AI Studio)
# Supports AIza… and AQ.… keys via langchain-google-genai (ChatGoogleGenerativeAI).
GEMINI_API_KEY=AIzaSy_YOUR_ACTUAL_GEMINI_KEY_HERE

# Optional paid providers
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# FinOps model tiers — flash-lite (~500 RPD free) avoids 20/day flash caps
MODEL_LOW=gemini-3.5-flash-lite
MODEL_MID=gemini-3.5-flash-lite
MODEL_HIGH=gemini-3.5-flash-lite

# GitHub
GITHUB_TOKEN=ghp_...
GITHUB_REPO_NAME=your-org/your-repo
GITHUB_BASE_BRANCH=main

# Google Drive
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
GDRIVE_FOLDER_ID=
GDRIVE_BUG_FILE_ID=

# Runtime defaults
# TARGET_REPO_PATH=/absolute/path/to/local/clone
ENABLE_REVISION_LOOP=true

# Test runner
PYTEST_ARGS=-q --tb=short
# Optional: absolute path to the *target repo* Python (its venv).
# If unset, auto-detects <repo>/.venv/bin/python (and common aliases).
# TARGET_PYTHON_BIN=/Users/sathibiswas/engineering-playground/engineering-playground/codecracker/.venv/bin/python
