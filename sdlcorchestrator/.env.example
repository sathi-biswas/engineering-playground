# LLM Provider (openai | anthropic)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# FinOps model tiers (optional overrides)
MODEL_LOW=gpt-4o-mini
MODEL_MID=gpt-4o
MODEL_HIGH=o3-mini
# MODEL_LOW_ANTHROPIC=claude-3-haiku-20240307
# MODEL_MID_ANTHROPIC=claude-3-5-sonnet-20241022
# MODEL_HIGH_ANTHROPIC=claude-3-5-sonnet-20241022

# GitHub
GITHUB_TOKEN=ghp_...
GITHUB_REPO_NAME=your-org/your-repo
GITHUB_BASE_BRANCH=main

# Google Drive
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GDRIVE_FOLDER_ID=optional-folder-id

# Runtime defaults
# TARGET_REPO_PATH=/absolute/path/to/local/clone
ENABLE_REVISION_LOOP=true

# Test runner
PYTEST_ARGS=-q --tb=short
