# LLM Provider: gemini (default, free) | openai | anthropic
LLM_PROVIDER=gemini

# Gemini API Key (100% Free from Google AI Studio)
# Supports AIza… and AQ.… keys via langchain-google-genai (ChatGoogleGenerativeAI).
# Do NOT pass this key to ChatOpenAI / OpenAI-compat base_url wrappers.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy_YOUR_ACTUAL_GEMINI_KEY_HERE

# Optional paid providers
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# FinOps model tiers (Gemini free-tier defaults)
MODEL_LOW=gemini-3.6-flash
MODEL_MID=gemini-3.6-flash
MODEL_HIGH=gemini-3.6-flash
# MODEL_LOW_OPENAI=gpt-4o-mini
# MODEL_MID_OPENAI=gpt-4o
# MODEL_HIGH_OPENAI=o3-mini
# MODEL_LOW_ANTHROPIC=claude-3-haiku-20240307
# MODEL_MID_ANTHROPIC=claude-3-5-sonnet-20241022
# MODEL_HIGH_ANTHROPIC=claude-3-5-sonnet-20241022

# GitHub
GITHUB_TOKEN=ghp_...
GITHUB_REPO_NAME=your-org/your-repo
GITHUB_BASE_BRANCH=main

# Google Drive
# Option A: OAuth Desktop client JSON (what Google Cloud Console downloads for "Desktop app")
# First run opens a browser; token is cached at credentials/token.json
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
GDRIVE_FOLDER_ID=
GDRIVE_BUG_FILE_ID=
# Option B: service account JSON (type=service_account) — share Drive files with the SA email
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa.json

# Runtime defaults
# TARGET_REPO_PATH=/absolute/path/to/local/clone
ENABLE_REVISION_LOOP=true

# Test runner
PYTEST_ARGS=-q --tb=short
