# Copy to .env and fill in what you use.
# Without LLM keys, CodeCracker runs in heuristic mode.

# Optional PAT — authenticated clones raise GitHub rate limits
# GITHUB_TOKEN=
# GH_TOKEN=
# CODECRACKER_GITHUB_TOKEN=

# Minimum seconds between fresh clones (reuses are free). Default: 5
# CODECRACKER_CLONE_INTERVAL=5

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional LLM overrides
# CODECRACKER_LLM=auto
# CODECRACKER_OPENAI_MODEL=gpt-4o-mini
# CODECRACKER_ANTHROPIC_MODEL=claude-3-5-haiku-latest
